# Copiar a .dev.vars para desarrollo local con wrangler pages dev
# En producción, cargar con: wrangler pages secret put JWT_SECRET
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# User-Agent requerido por la política de uso de Nominatim
NOMINATIM_UA=scalerics-logistica/0.1 (contacto@ejemplo.com)
